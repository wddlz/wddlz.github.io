    <!-- Hero Section -->
    <section id="intro" class="hero">
      <div class="hero-content">
        <img
          src="avatar.png"
          alt="Ian Drosos"
          style="
            width: 240px;
            height: 240px;
            border-radius: 50%;
            margin-bottom: var(--space-6);
            border: 3px solid var(--color-accent-primary);
            box-shadow: var(--shadow-glow);
          "
          loading="eager"
        />
        <h1 class="hero-title">Ian Drosos</h1>
        <p class="hero-subtitle">Security & AI Designer / Developer</p>
        <p class="hero-description">
          I lead UX design engineering at Trent AI, a security startup making
          code and organizations safer. I am a mixed-methods HCI researcher
          designing tools for developers, data scientists, content creators, and
          learners. Publishing at venues such as
          <a href="https://dl.acm.org/conference/chi">CHI</a>,
          <a href="https://dl.acm.org/conference/dis">DIS</a>, and
          <a href="https://conferences.computer.org/VLHCC/">VLHCC</a>.
        </p>
        <div class="btn-group">
          <a href="#one" class="btn btn-primary">View My Work</a>
          <a href="#two" class="btn btn-secondary">Experience</a>
          <a href="images/Ian_Drosos_Resume.pdf" class="btn btn-secondary"
            >Resume</a
          >
          <a href="images/CV_Ian_Drosos.pdf" class="btn btn-secondary">CV</a>
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section id="one" class="section">
      <div class="container">
        <h2 style="text-align: center; margin-bottom: var(--space-12)">
          Featured Work
        </h2>

        <div class="bento-grid">
          <!-- Promptly - Large Featured Card -->
          <div
            class="bento-item bento-item-large reveal"
            style="position: relative"
          >
            <img
              src="images/DPM/UserFlowWithDynamic.png"
              alt="Promptly Interface"
              class="bento-image"
              loading="lazy"
            />
            <div
              style="
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(
                  to bottom,
                  rgba(0, 0, 0, 0.85) 0%,
                  rgba(0, 0, 0, 0.95) 100%
                );
                border-radius: var(--radius-xl);
              "
            ></div>
            <div class="bento-content" style="position: relative; z-index: 1">
              <h3 class="card-title">Promptly / Dynamic Prompt Middleware</h3>
              <p class="card-description">
                Prompting generative AI effectively is challenging for users,
                particularly in expressing context for comprehension tasks. We
                address this challenge by creating Dynamic Prompt Middleware,
                which generates UI elements for prompt refinement based on the
                user's specific prompt. Users found it afforded more control,
                lowered barriers to providing context, encouraged task
                exploration and reflection, and improved the user experience of
                generative AI workflows. Promptly won 2nd place at Microsoft's
                2024 Hackathon as part of the 'Everyday AI' Executive Challenge.
              </p>
              <div class="badge-group">
                <span class="badge badge-publication">CHIWORK 2025</span>
                <span class="badge badge-award">
                  <i data-lucide="trophy" style="width: 14px; height: 14px"></i>
                  2nd Place Hackathon
                </span>
              </div>
              <div style="margin-top: var(--space-6)">
                <a href="promptly.html" class="btn btn-primary">Learn More</a>
                <a
                  href="https://arxiv.org/pdf/2412.02357"
                  class="btn btn-secondary"
                  style="margin-left: var(--space-3)"
                  >Read Paper</a
                >
              </div>
            </div>
          </div>

          <!-- Wrex -->
          <div class="bento-item reveal" style="position: relative">
            <img
              src="images/chrome-png-highres.png"
              alt="Wrex Interface"
              class="bento-image"
              loading="lazy"
            />
            <div
              style="
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(
                  to bottom,
                  rgba(0, 0, 0, 0.85) 0%,
                  rgba(0, 0, 0, 0.95) 100%
                );
                border-radius: var(--radius-xl);
              "
            ></div>
            <div class="bento-content" style="position: relative; z-index: 1">
              <h3 class="card-title">Wrex</h3>
              <p class="card-description">
                Created a unified programming-by-example interaction for
                synthesizing readable code within Jupyter notebooks. Data
                scientists found it made them significantly more effective at
                data wrangling.
              </p>
              <div class="badge-group">
                <span class="badge badge-publication">CHI 2020</span>
                <span class="badge badge-award">
                  <i data-lucide="trophy" style="width: 14px; height: 14px"></i>
                  Best Paper Award
                </span>
              </div>
              <div style="margin-top: var(--space-4)">
                <a href="wrex.html" class="btn btn-primary">Learn More</a>
                <a
                  href="https://dl.acm.org/doi/pdf/10.1145/3313831.3376442"
                  class="btn btn-secondary"
                  style="margin-left: var(--space-3)"
                  >Read Paper</a
                >
              </div>
            </div>
          </div>

          <!-- FxD -->
          <div class="bento-item reveal" style="position: relative">
            <img
              src="images/Overview.png"
              alt="FxD Interface"
              class="bento-image"
              loading="lazy"
            />
            <div
              style="
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(
                  to bottom,
                  rgba(0, 0, 0, 0.85) 0%,
                  rgba(0, 0, 0, 0.95) 100%
                );
                border-radius: var(--radius-xl);
              "
            ></div>
            <div class="bento-content" style="position: relative; z-index: 1">
              <h3 class="card-title">FxD</h3>
              <p class="card-description">
                Led HCI research on a novel functional debugger for
                dysfunctional spreadsheets which provided structured information
                for improved systematic formula debugging. Released as part of
                Excel Labs.
              </p>
              <div class="badge-group">
                <span class="badge badge-publication">VLHCC 2023</span>
                <span class="badge badge-award">
                  <i data-lucide="trophy" style="width: 14px; height: 14px"></i>
                  Best Paper HM
                </span>
              </div>
              <div style="margin-top: var(--space-4)">
                <a href="fxd.html" class="btn btn-primary">Learn More</a>
                <a
                  href="https://www.microsoft.com/en-us/research/publication/fxd-a-functional-debugger-for-dysfunctional-spreadsheets/"
                  class="btn btn-secondary"
                  style="margin-left: var(--space-3)"
                  >Read Paper</a
                >
              </div>
            </div>
          </div>

          <!-- Trent AI - Coming Soon -->
          <div class="bento-item reveal" style="position: relative">
            <div
