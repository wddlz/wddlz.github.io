                  rel="noopener noreferrer"
                  class="btn btn-primary"
                  style="
                    display: inline-flex;
                    align-items: center;
                    gap: var(--space-2);
                  "
                >
                  <i
                    data-lucide="external-link"
                    style="width: 18px; height: 18px"
                  ></i>
                  Visit Trent AI
                </a>
              </div>
            </div>
          </div>

          <!-- Microsoft Contributions -->
          <div
            class="bento-item bento-item-wide reveal"
            style="position: relative"
          >
            <img
              src="images/productlogos.png"
              alt="Microsoft Products"
              class="bento-image"
